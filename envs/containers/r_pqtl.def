Bootstrap: docker
From: rocker/r-ver:4.4.0

%post
    apt-get update && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        zlib1g-dev \
        && rm -rf /var/lib/apt/lists/*

    R -e "install.packages(c('data.table', 'dplyr', 'stringr', 'tidyr', 'ggplot2'), repos='https://cloud.r-project.org')"

%labels
    Author pqtl-pipeline
    Version 1.0
